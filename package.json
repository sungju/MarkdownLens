{
  "name": "markdown-lens",
  "version": "1.0.1",
  "description": "Markdown Lens — a fast, themeable Markdown viewer for Chrome.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://baramsoft.com",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "promo": "node scripts/make-promo.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node scripts/smoke.mjs",
    "serve": "node scripts/serve-test.mjs",
    "id": "node scripts/extension-id.mjs",
    "release": "node scripts/build.mjs --release && node scripts/package.mjs",
    "store-kit": "node scripts/store-kit.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.21",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.4.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
